{
	"name": "obsidian-lint-and-format",
	"version": "0.1.0",
	"description": "Advanced linting and formatting tools for Markdown files in Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"setup": "bash ./build-plugin.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.claude\" \"#memory\" \"#CLAUDE.md\"",
		"lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#.claude\" \"#memory\" \"#CLAUDE.md\"",
		"lint:remark": "remark . --ext md --quiet --frail",
		"lint:remark:fix": "remark . --ext md --output --quiet",
		"precommit": "npm run lint:md:fix"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"lint",
		"format",
		"markdown"
	],
	"author": "Md. Sazzad Hossain Sharkar <https://szd.sh/>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/devops-infinity/obsidian-lint-and-format"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"markdownlint": "^0.38.0",
		"prettier": "^3.6.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-document": "^7.0.3",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"remark-toc": "^9.0.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.7.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.1",
		"@typescript-eslint/eslint-plugin": "^8.46.0",
		"@typescript-eslint/parser": "^8.46.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.25.10",
		"markdownlint-cli2": "^0.18.1",
		"obsidian": "latest",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"remark-cli": "^12.0.1",
		"remark-lint-heading-style": "^4.0.1",
		"remark-lint-maximum-heading-length": "^4.1.1",
		"remark-lint-no-duplicate-headings-in-section": "^4.0.1",
		"remark-lint-no-empty-url": "^4.0.1",
		"remark-lint-no-undefined-references": "^5.0.2",
		"remark-preset-lint-consistent": "^6.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"remark-preset-prettier": "^2.0.2",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}
