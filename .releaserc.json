{
    "branches": ["main"],
    "tagFormat": "${version}",
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits",
                "releaseRules": [
                    { "type": "feat", "release": "minor" },
                    { "type": "fix", "release": "patch" },
                    { "type": "perf", "release": "patch" },
                    { "type": "refactor", "release": "patch" },
                    { "type": "build", "release": "patch" },
                    { "type": "ci", "release": false },
                    { "type": "chore", "release": false },
                    { "type": "docs", "release": false },
                    { "type": "style", "release": false },
                    { "type": "test", "release": false },
                    { "breaking": true, "release": "major" }
                ]
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits",
                "presetConfig": {
                    "types": [
                        { "type": "feat", "section": "Features" },
                        { "type": "fix", "section": "Bug Fixes" },
                        { "type": "perf", "section": "Performance" },
                        { "type": "refactor", "section": "Refactoring" },
                        { "type": "build", "section": "Build" },
                        { "type": "ci", "section": "CI", "hidden": true },
                        { "type": "chore", "section": "Chores", "hidden": true },
                        { "type": "docs", "section": "Documentation", "hidden": true },
                        { "type": "style", "section": "Styling", "hidden": true },
                        { "type": "test", "section": "Tests", "hidden": true }
                    ]
                }
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "node version-bump.mjs ${nextRelease.version} && npm run build && rm -rf release-staging && mkdir -p release-staging/obsidian-lint-and-format && cp main.js manifest.json styles.css release-staging/obsidian-lint-and-format/ && (cd release-staging && zip -r ../obsidian-lint-and-format-${nextRelease.version}.zip obsidian-lint-and-format)"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    { "path": "main.js", "label": "main.js" },
                    { "path": "manifest.json", "label": "manifest.json" },
                    { "path": "styles.css", "label": "styles.css" },
                    { "path": "obsidian-lint-and-format-*.zip", "label": "Plugin folder (extract into .obsidian/plugins/)" }
                ],
                "successComment": false,
                "failComment": false,
                "releasedLabels": false
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": ["manifest.json", "versions.json"],
                "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
            }
        ]
    ]
}
